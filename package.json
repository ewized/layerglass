{
  "name": "layerglass-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "nx run-many -t test --projects=layerglass,demo-backend,local-backend",
    "test:python": "nx test python-backend",
    "test:browser": "nx run layerglass:browser",
    "build": "nx run-many -t build --projects=python-backend,layerglass,demo-backend,local-backend,layerglass-site",
    "check:docs": "nx run docs:check",
    "graph": "nx graph",
    "typecheck": "node scripts/typecheck.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config apps scripts infra/cloudflare/src infra/cloudflare/tests eslint.config.ts",
    "format:check": "prettier --check \"apps/**/*.ts\" \"scripts/*.ts\" \"infra/cloudflare/**/*.ts\" \"types/*.d.ts\" \"*.json\" \"eslint.config.ts\"",
    "format": "prettier --write \"apps/**/*.ts\" \"scripts/*.ts\" \"infra/cloudflare/**/*.ts\" \"types/*.d.ts\" \"*.json\" \"eslint.config.ts\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "hls.js": "1.7.3",
    "nx": "24.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "nx": {
    "includedScripts": []
  },
  "engines": {
    "node": ">=24.12"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/css": "11.13.5",
    "lit": "3.3.3"
  }
}
