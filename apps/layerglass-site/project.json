{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "layerglass-site",
  "projectType": "application",
  "sourceRoot": "apps/layerglass-site/src",
  "tags": [
    "type:application",
    "runtime:browser",
    "scope:product"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/scripts/build-static.mjs"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/layerglass-site"
      ],
      "options": {
        "command": "node scripts/build-static.mjs layerglass-site"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "build",
        {
          "projects": [
            "layerglass"
          ],
          "target": "build"
        }
      ],
      "options": {
        "command": "node apps/layerglass-site/tests/browser-site.js"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node scripts/serve-static.mjs layerglass-site 8102"
      }
    }
  }
}
