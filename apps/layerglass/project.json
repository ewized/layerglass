{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "layerglass",
  "projectType": "application",
  "sourceRoot": "apps/layerglass/src",
  "tags": [
    "type:application",
    "runtime:browser",
    "scope:player"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/build-static.ts",
        "{workspaceRoot}/scripts/compile-browser.ts",
        "{workspaceRoot}/infra/cloudflare/src/**/*.ts"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/layerglass",
        "{workspaceRoot}/dist/apps/.edge/layerglass.mjs",
        "{workspaceRoot}/dist/browser/apps/layerglass/src"
      ],
      "options": {
        "command": "node scripts/build-static.ts layerglass"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/check-typescript-only.ts"
      ],
      "outputs": [],
      "options": {
        "command": "node --import tsx --experimental-vm-modules --test apps/layerglass/tests/*.test.ts"
      }
    },
    "browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "./scripts/check.sh browser"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "docker compose -f compose.dev.yaml up --build viewer"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node scripts/serve-static.ts layerglass 8101"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "options": {
        "command": "node scripts/typecheck.ts"
      }
    }
  },
  "implicitDependencies": [
    "demo-backend",
    "local-backend",
    "backend-contracts"
  ]
}
