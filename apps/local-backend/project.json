{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "local-backend",
  "projectType": "library",
  "sourceRoot": "apps/local-backend/src",
  "tags": [
    "type:backend",
    "runtime:browser",
    "scope:local"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/build-browser-backend.mjs"
      ],
      "outputs": [
        "{workspaceRoot}/dist/backends/local-backend"
      ],
      "options": {
        "command": "node scripts/build-browser-backend.mjs local-backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [],
      "options": {
        "command": "node --test apps/local-backend/tests/*.test.js"
      }
    }
  }
}
