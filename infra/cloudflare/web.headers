/*
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com chrome-extension://pkedcjkdefgpdelpbcmbmeomcjbeemfm chrome-extension://enhhojjnijigcajfphajepfemndkmdlo; style-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/service-worker.js
  Service-Worker-Allowed: /

https://app.layer.glass/*
  X-Robots-Tag: noindex
