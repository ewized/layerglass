# GitHub: add these two keys as secrets in the cloudflare-production environment.
# Local deployment: fill a private Docker --env-file outside the checkout.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Also set this GitHub repository Actions VARIABLE (not a secret):
# CLOUDFLARE_DEPLOY_ENABLED=true
# Setup guide: docs/operations/github-deployment.md
