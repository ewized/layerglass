# GitHub: add these keys as secrets in the cloudflare-production environment.
# Local deployment: fill a private Docker --env-file outside the checkout.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Successful main CI automatically deploys both sites and publishes the Docker image.
# No CLOUDFLARE_DEPLOY_ENABLED variable is required.
# Setup guide: docs/operations/github-deployment.md
