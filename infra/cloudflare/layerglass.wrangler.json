{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "layerglass-web",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "app.layer.glass",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../dist/apps/layerglass",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/.edge/*",
      "/_headers",
      "/.assetsignore"
    ]
  },
  "observability": {
    "enabled": false
  },
  "send_metrics": false,
  "main": "../../dist/apps/.edge/layerglass.mjs",
  "no_bundle": true,
  "find_additional_modules": false
}
