{
  "name": "cloudflare",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "scope:delivery"
  ],
  "targets": {
    "prepare": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "layerglass",
            "layerglass-site"
          ]
        }
      ],
      "cache": false,
      "options": {
        "command": "node scripts/cloudflare.ts prepare all"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npm --prefix infra/cloudflare test"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prepare"
      ],
      "cache": false,
      "options": {
        "command": "node scripts/cloudflare.ts check all"
      }
    },
    "dry-run": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prepare"
      ],
      "cache": false,
      "options": {
        "command": "node scripts/cloudflare.ts dry-run all"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "prepare"
      ],
      "cache": false,
      "options": {
        "command": "node scripts/cloudflare.ts deploy all"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/cloudflare.ts verify all"
      }
    }
  }
}
