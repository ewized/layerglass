# Discover approved printers, or supply an approved printer stream URL.
# Example: rtsps://bblp:ACCESS_CODE@PRINTER_IP:322/streaming/live/1
# URL-encode special characters in the access code if necessary.
STREAM_URL=
VIEWER_PORT=8099
VIEWER_BIND_ADDRESS=0.0.0.0

# Keep UI files network-only during active development. Set 1 for offline caching.
PWA_CACHE_ENABLED=0

# copy remuxes H.264 without re-encoding. transcode converts other codecs
# to H.264, using more CPU, and gives regular 2-second keyframes.
STREAM_MODE=copy
TRANSCODE_FPS=15

STALE_TIMEOUT_SECONDS=30
RECONNECT_DELAY_SECONDS=3

# Empty scans the /24 subnet containing STREAM_URL's private IPv4 address.
# Set explicitly for other subnets or when STREAM_URL is empty. Max 4096 addresses.
DISCOVERY_CIDRS=192.168.1.0/24
# Camera ports come from providers/approved-printers.json.
# DISCOVERY_PORTS cannot add ports outside that approved list.

# Temporary rewind history, collected only while viewer pages are open.
REPLAY_MAX_MB=8192
REPLAY_SESSION_TIMEOUT_SECONDS=1800

# Optional Unraid WebUI link when an HTTPS reverse proxy is configured.
# LAYERGLASS_URL=https://your-viewer.example.com
